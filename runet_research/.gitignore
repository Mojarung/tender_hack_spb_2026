# uv-managed venv — recreated by `uv sync`, not in version control.
.venv/

# Heavy nodriver Chrome profile — keeps cookies/cache across runs but no
# value in source control. Mirror of ozon_research/.gitignore + wb_research.
.profile_yandex/

# Probe artifacts — keep the directory structure (_out/.gitkeep), drop the
# rotating JSON dumps + screenshots. They're regenerated by re-running the
# probes; committing them just bloats history.
_out/*
!_out/.gitkeep
