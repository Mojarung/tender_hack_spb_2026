# uv-managed venv
.venv/

# Persistent nodriver Chrome profile (huge, churns binary blobs).
.profile_wb/

# Per-run JSON dumps from the diagnostic scripts.
_out/*.json
_out/*.png
_out/*.csv
_out/*.webp
_out/*.jpg
_out/*.mp4
_out/*.m3u8
_out/*.ts
!_out/.gitkeep

# Ad-hoc debug captures
log*.png
log*.txt
error*.txt
*.log
