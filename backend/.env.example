# ===== App =====
APP_ENV=local
APP_LOG_LEVEL=INFO

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ===== Postgres =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pricepulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pricepulse

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Scraping — proxy pools (см. backend/docs/anti-bot.md, §3) =====
# Sticky-session residential RU IPs (IPRoyal / Astroproxy / Belurk)
PROXY_POOL_RESIDENTIAL=
# Datacenter RU IPs (Proxy6, Aeza) для WB и smoke-tests
PROXY_POOL_DATACENTER=

# Browser pool sizes (per source)
OZON_BROWSER_POOL=2
YANDEX_MARKET_BROWSER_POOL=2

# Per-source rate limit (requests per minute, per proxy)
WB_RPM=60
OZON_RPM=20
YANDEX_MARKET_RPM=10
RUNET_RPM=30

# ===== CAPTCHA — 2captcha (платежи в рублях через QIWI) =====
# Получи на 2captcha.com, минимальный депозит ~$1
TWOCAPTCHA_API_KEY=

# ===== L3 fallback (зарубежные сервисы, free tier) =====
# Регистрировать заранее с зарубежной почты, без карты
SCRAPFLY_API_KEY=
APIFY_API_TOKEN=
ZENROWS_API_KEY=
FIRECRAWL_API_KEY=

# ===== Firecrawl self-host (бесплатный fallback) =====
FIRECRAWL_URL=http://firecrawl-api:3002
SEARXNG_URL=http://localhost:8080

# ===== LLM extraction (для 4-го источника) =====
# Gemini 3 Flash — самый дешёвый mainstream ($0.075/1M input)
GEMINI_API_KEY=
# DeepSeek V4 Flash — лучший value, доступен из РФ через крипту/Alipay
DEEPSEEK_API_KEY=

# ===== S3 / MinIO (кэш картинок) =====
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=pricepulse
S3_SECRET_KEY=pricepulse_dev_password
S3_BUCKET=pricepulse-images
S3_REGION=us-east-1

# ===== n8n =====
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=hackathon
# openssl rand -hex 32 — НИКОГДА не менять после первого запуска
N8N_ENCRYPTION_KEY=

# ===== Grafana =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=hackathon

# ===== Gemma 4 — vision + image search =====
OLLAMA_URL=https://evening-trinity-throwing-imported.trycloudflare.com
OLLAMA_API_KEY=d2f628410642024bed87961b4bf2dc2cca0dc135cc4cf1ac2f8df1d6b1de2426
OLLAMA_VISION_MODEL=gemma4:e4b

# ===== Notifications =====
NTFY_URL=http://ntfy/pricepulse-alerts
APPRISE_URL=http://apprise:8000/notify/pricepulse

# ===== Admin services =====
PGADMIN_PASSWORD=hackathon
GLITCHTIP_SECRET_KEY=replace_with_openssl_rand_hex_32

# ===== Feature flags (free-mode by default) =====
# Глобальный killswitch — если false, никакая платная ветка НИКОГДА не вызывается.
# Подробности: backend/docs/free-mode.md
FEATURES_ALLOW_PAID=false

# Гранулярно — что разрешено, КОГДА allow_paid=true. По одному.
FEATURE_USE_PAID_PROXIES=false       # IPRoyal / Smartproxy / etc.
FEATURE_USE_2CAPTCHA=false           # 2Captcha (рубли) — только на Kaleidoscope
FEATURE_USE_PAID_LLM=false           # Gemini Flash / DeepSeek (вместо локальной Gemma 4)
FEATURE_USE_PAID_L3=false            # платные тарифы Scrapfly/Apify/ZenRows (free квоты OK всегда)

# Demo-mode — прогрев Redis-кэша для жюри. <100ms по «горячим» запросам.
DEMO_MODE=false

# Cost guard. В free-mode = 0 (платное вообще выключено).
COST_CAP_USD=0
