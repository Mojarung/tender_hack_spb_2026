# ===== App =====
APP_ENV=local
APP_LOG_LEVEL=INFO

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# Base host (без порта) для админ-ссылок — переопределяем под прод.
ADMIN_HOST=http://localhost

# ===== Postgres =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pricepulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pricepulse

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== Scraping — proxy pools (опционально; в CLAUDE.md → Anti-bot слой) =====
# Sticky-session residential RU IPs (для Ozon/Yandex Market если живой банан)
PROXY_POOL_RESIDENTIAL=
# Datacenter RU IPs для WB и smoke-tests
PROXY_POOL_DATACENTER=

# Browser pool sizes (per source)
OZON_BROWSER_POOL=2
YANDEX_MARKET_BROWSER_POOL=2

# Per-source rate limit (requests per minute, per proxy)
WB_RPM=60
OZON_RPM=20
YANDEX_MARKET_RPM=10
RUNET_RPM=30

# ===== 4-й источник — self-hosted SearXNG =====
# Только обнаружение URL; HTML-скрейпинг + JSON-LD парсинг — наш код
# (backend/src/pricepulse/scrapers/runet.py). Конфиг SearXNG —
# backend/searxng/settings.yml (включает format=json).
SEARXNG_URL=http://searxng:8080

# ===== SpellCheck — RU spell-correction микросервис =====
# Self-hosted SAGE FRED-T5 distilled-95M (от Сбера), F1=78.9 на RUSpellRU.
# Backend код в backend/spellcheck/. Пусто = выключен; normalize_query
# работает без общеязыковой коррекции (бренд-тезаурус и pymorphy3 остаются).
SPELLCHECK_URL=http://spellcheck:8080

# ===== S3 / MinIO (кэш картинок) =====
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=pricepulse
S3_SECRET_KEY=pricepulse_dev_password
S3_BUCKET=pricepulse-images
S3_REGION=us-east-1

# ===== n8n =====
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=hackathon
# openssl rand -hex 32 — НИКОГДА не менять после первого запуска
N8N_ENCRYPTION_KEY=

# ===== Grafana =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=hackathon

# ===== Ollama (Gemma 4 — vision captcha-solver + image search) =====
# Ollama выведен в отдельный микросервис, поднимается на машине с GPU.
# Backend ходит к нему по HTTP — настройка только через эту переменную.
#
#   1) Prod / staging — выделенный GPU-хост (рекомендуется):
#        OLLAMA_URL=http://ollama-gpu.internal.example.com:11434
#   2) Local dev с docker-profile (для теста, CPU-only — медленно):
#        cd backend && docker compose --profile gpu up -d ollama
#        OLLAMA_URL=http://ollama:11434
#   3) Cloud-first демо через локальный Ollama-прокси:
#        ollama signin
#        ollama pull gemma4:31b-cloud
#        OLLAMA_URL=http://127.0.0.1:11434
#        OLLAMA_VISION_MODEL=gemma4:31b-cloud
#      Cloud-first демо через прямой API key:
#        OLLAMA_URL=https://ollama.com
#        OLLAMA_API_KEY=...
#        OLLAMA_VISION_MODEL=gemma4:31b
#   4) Демо без Ollama — оставь дефолтным и положись на graceful degradation
#      (slider-solver + текстовый pipeline продолжат работать без VLM).
OLLAMA_URL=http://ollama:11434
OLLAMA_API_KEY=
OLLAMA_VISION_MODEL=gemma4:e4b
IMAGE_SEARCH_MAX_BYTES=8000000
IMAGE_SEARCH_CACHE_TTL_SECONDS=86400

# ===== Notifications =====
NTFY_URL=http://ntfy/pricepulse-alerts
APPRISE_URL=http://apprise:8000/notify/pricepulse

# ===== Admin services =====
PGADMIN_PASSWORD=hackathon
GLITCHTIP_SECRET_KEY=replace_with_openssl_rand_hex_32

# ===== Demo mode =====
# Прогрев Redis-кэша для жюри — горячие запросы отвечают <100 ms.
# Платные feature-flags и cost-guard убраны: проект больше не вызывает
# никаких сторонних платных сервисов (методичка, final_presa.pdf p.5).
DEMO_MODE=false
