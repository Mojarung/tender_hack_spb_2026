# ===== App =====
APP_ENV=local
APP_LOG_LEVEL=INFO

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ===== Postgres =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pricepulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pricepulse

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== Scraping =====
# Comma-separated proxy URIs: user:pass@host:port
PROXY_POOL_RESIDENTIAL=
PROXY_POOL_DATACENTER=

# Browser pool sizes (per source)
OZON_BROWSER_POOL=2
YANDEX_MARKET_BROWSER_POOL=2

# Per-source rate limit (requests per minute, per proxy)
WB_RPM=60
OZON_RPM=20
YANDEX_MARKET_RPM=10
RUNET_RPM=30

# ===== CAPTCHA =====
# Optional: leave empty to gracefully skip Yandex SmartCaptcha pages
TWOCAPTCHA_API_KEY=

# ===== Firecrawl (self-host) =====
FIRECRAWL_URL=http://firecrawl-api:3002
FIRECRAWL_API_KEY=

# ===== SearXNG =====
SEARXNG_URL=http://searxng:8080
